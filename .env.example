# MongoDB connection string
MONGODB_URL=mongodb://127.0.0.1:27017/voting_app

# Secret key used to sign JWT tokens
JWT_SECRET=your_jwt_secret_here

# Port the server listens on (optional, defaults to 3000)
PORT=3000

# Allowed CORS origin for the frontend (optional, defaults to * which allows all origins)
# Set this to your frontend URL in production, e.g. https://yourdomain.com
ALLOWED_ORIGIN=http://localhost:5173
